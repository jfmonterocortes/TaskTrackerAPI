@inject IConfiguration Configuration
@{
    var apiBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7134/api/v1/tasks";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskTracker</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="nav-brand">
                <h1> TaskTracker</h1>
            </div>
            <ul class="nav-menu">
                <li><a href="/">All Tasks</a></li>
                <li><a href="/Home/CreateTask">Add New Task</a></li>
                <li><a href="/Home/SearchTasks">Search Tasks</a></li>
            </ul>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <p>&copy; 2025 TaskTracker - SENG2020 Project</p>
    </footer>

    <script src="~/js/app.js" asp-append-version="true"></script>
    <script>
        window.appConfig = {
            apiBaseUrl: '@apiBaseUrl'
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
